generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FoundationMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          String   @id @default(cuid())
  name        String   @unique
  shortCode   String   @unique
  description String?
  scenes      Scene[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String
  areaName  String?
  latitude  Float?
  longitude Float?
  mapsUrl   String?
  scenes    Scene[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, areaName])
  @@index([areaName])
}

model Scene {
  id                    String      @id @default(cuid())
  sceneCode             String      @unique
  workId                String
  episode               String?
  animeImageDriveFileId String
  locationId            String
  latitude              Float?
  longitude             Float?
  mapsUrl               String?
  notes                 String?
  status                SceneStatus @default(NOT_SHOT)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  work                  Work         @relation(fields: [workId], references: [id], onDelete: Restrict)
  location              Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tripScenes            TripScene[]
  photos                ScenePhoto[]

  @@index([workId])
  @@index([locationId])
  @@index([status])
}

model Trip {
  id        String       @id @default(cuid())
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  days      TripDay[]
  photos    ScenePhoto[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([startDate])
}

model TripDay {
  id         String       @id @default(cuid())
  tripId     String
  date       DateTime     @db.Date
  title      String?
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripScenes TripScene[]
  photos     ScenePhoto[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([tripId, date])
  @@index([date])
}

model TripScene {
  id        String   @id @default(cuid())
  tripDayId String
  sceneId   String
  sortOrder Int
  tripDay   TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDayId, sceneId])
  @@index([tripDayId, sortOrder])
  @@index([sceneId])
}

model ScenePhoto {
  id            String    @id @default(cuid())
  sceneId       String
  tripId        String?
  tripDayId     String?
  fileName      String
  mimeType      String
  fileSize      Int
  storageFileId String    @unique
  capturedAt    DateTime?
  uploadedAt    DateTime  @default(now())
  takeNumber    Int
  isBest        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  scene         Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripDay       TripDay?  @relation(fields: [tripDayId], references: [id], onDelete: SetNull)

  @@unique([sceneId, takeNumber])
  @@index([sceneId, takeNumber])
  @@index([tripId])
  @@index([tripDayId])
}

enum SceneStatus {
  NOT_SHOT
  PENDING_REVIEW
  REVIEWED
  RETAKE_REQUIRED
  SKIPPED
}
